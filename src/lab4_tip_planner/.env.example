# ============================================================
# Agencia de Viajes Inteligente — Variables de Entorno
# ============================================================
# Copia este archivo como .env y rellena tus API keys.

# --- LLM Provider (elige uno) ---
# OpenAI (por defecto en CrewAI)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini (alternativa a OpenAI)
# GEMINI_API_KEY=your-gemini-api-key-here

# --- Herramientas de búsqueda (necesario para imágenes de alojamientos) ---
# Serper.dev — búsqueda web e imágenes reales para los agentes
# Regístrate gratis en https://serper.dev
SERPER_API_KEY=your-serper-api-key-here
